<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Application loggers -->
    <logger name="org.llm4s.ragbox" level="${LOG_LEVEL:-INFO}" />

    <!-- llm4s library logging -->
    <logger name="org.llm4s" level="${LOG_LEVEL:-INFO}" />

    <!-- HTTP4s logging (reduce noise) -->
    <logger name="org.http4s" level="INFO" />
    <logger name="org.http4s.ember" level="WARN" />
    <logger name="org.http4s.blaze" level="WARN" />
    <logger name="org.http4s.client" level="INFO" />

    <!-- Database logging -->
    <logger name="com.zaxxer.hikari" level="WARN" />
    <logger name="org.postgresql" level="WARN" />

    <!-- Reduce noise from other libraries -->
    <logger name="io.netty" level="WARN" />
    <logger name="org.flywaydb" level="INFO" />

    <!--
      Root logger: set LOG_FORMAT=json for structured JSON output (production),
      any other value gives human-readable console output (development).
      Uses logback's built-in property condition (logback >= 1.5.20), so no
      Janino / runtime code compilation is needed.
    -->
    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>LOG_FORMAT</key>
        <value>json</value>
    </condition>
    <if>
        <then>
            <!-- JSON appender for production (structured logging, one object per line) -->
            <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
                <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                    <timeZone>UTC</timeZone>
                    <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
                    <!-- Keep the field names emitted by the previous JSON layout -->
                    <fieldNames>
                        <timestamp>timestamp</timestamp>
                        <logger>logger</logger>
                        <thread>thread</thread>
                        <version>[ignore]</version>
                        <levelValue>[ignore]</levelValue>
                    </fieldNames>
                </encoder>
            </appender>
            <root level="${LOG_LEVEL:-INFO}">
                <appender-ref ref="JSON" />
            </root>
        </then>
        <else>
            <!-- Console appender with human-readable output (default for development) -->
            <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                    <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
            <root level="${LOG_LEVEL:-INFO}">
                <appender-ref ref="CONSOLE" />
            </root>
        </else>
    </if>
</configuration>
