# RAG in a Box - Environment Configuration
#
# Copy this file to .env and fill in the values you need. Every setting is optional unless
# marked REQUIRED; a commented-out line shows the built-in default (src/main/resources/application.conf).
#
#   ./run.sh               sources .env (set -a) before `sbt run`, so every variable here applies.
#   docker compose up      passes every variable here into the api container (env_file: .env), with
#                          the same defaults. Only the database (PG_*, DATABASE_URL: the compose
#                          postgres service), SERVER_HOST/SERVER_PORT and INGEST_DIR (/data, see
#                          INGEST_HOST_DIR) are fixed by docker-compose.yml.
#
# Secrets: never commit .env. Generate secrets rather than inventing them, e.g.
#   openssl rand -hex 32
# Values containing CHANGE_ME / REPLACE-ME (and similar template markers) are rejected at
# startup for API_KEY, JWT_SECRET and ADMIN_PASSWORD.

# =============================================================================
# Provider API keys (REQUIRED: a key for each provider you use)
# =============================================================================

# OpenAI - needed for the defaults (openai/gpt-4o answers, text-embedding-3-small embeddings).
# OPEN_AI_KEY is accepted as an alias.
OPENAI_API_KEY=

# Anthropic - for LLM_MODEL=anthropic/...
# ANTHROPIC_API_KEY=

# Voyage AI - for EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=

# Cohere - for RAG_RERANKING_STRATEGY=cohere
# COHERE_API_KEY=

# Any other llm4s provider: the variable its llm4s module binds, or <PROVIDER>_API_KEY
# MISTRAL_API_KEY=

# =============================================================================
# Server
# =============================================================================

# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================

# Individual settings (defaults match the postgres service in docker-compose.yml, published on 15432)
# PG_HOST=localhost
# PG_PORT=15432
# PG_DATABASE=ragdb
# PG_USER=rag
# PG_PASSWORD=rag
# Table for vector embeddings
# PG_TABLE_NAME=rag_embeddings

# Alternative: a connection URL, which overrides the settings above.
# Format: postgresql://[user[:password]@]host[:port][/database][?params]
# postgres:// and jdbc:postgresql:// are also accepted. Percent-encode special characters in
# the user name or password (e.g. @ -> %40). A missing port defaults to 5432; a missing
# user/password/database falls back to PG_USER/PG_PASSWORD/PG_DATABASE.
# DATABASE_URL=postgresql://rag:rag@localhost:15432/ragdb

# Size of the single HikariCP pool shared by every component
# DB_POOL_SIZE=10

# Apply pending Flyway migrations at startup. Set false when migrations run separately
# (`--migrate-only`, e.g. from a deploy job).
# DB_MIGRATE_ON_START=true

# Fail startup if permission-based RAG (the PostgreSQL SearchIndex) cannot be initialised,
# instead of falling back to legacy mode where queries ignore document permissions.
# PERMISSIONS_REQUIRED=false

# =============================================================================
# Embeddings
# =============================================================================

# Provider: openai, voyage or ollama (any llm4s embedding provider on the classpath)
# EMBEDDING_PROVIDER=openai

# Model (provider-specific). OpenAI and Voyage ids are from llm4s 1.0.0's bundled model metadata:
#   OpenAI: text-embedding-3-small (1536), text-embedding-3-large (3072)
#   Voyage: voyage-3.5, voyage-3.5-lite, voyage-3-large, voyage-code-3
#   Ollama: nomic-embed-text, mxbai-embed-large (set EMBEDDING_DIMENSIONS)
# EMBEDDING_MODEL=text-embedding-3-small

# Vector dimensions; taken from llm4s's model table when unset. Changing the embedding
# model or dimensions requires re-ingesting your documents.
# EMBEDDING_DIMENSIONS=1536

# Provider endpoint, when not the provider's default (e.g. a remote Ollama server)
# EMBEDDING_BASE_URL=http://ollama:11434

# =============================================================================
# LLM (answer generation)
# =============================================================================

# Format: provider/model (ids from llm4s 1.0.0's bundled model metadata), e.g.
#   OpenAI:    openai/gpt-4o (default), openai/gpt-4o-mini, openai/gpt-4.1, openai/gpt-5, openai/gpt-5-mini
#   Anthropic: anthropic/claude-sonnet-4-6, anthropic/claude-opus-4-7, anthropic/claude-haiku-4-5
#   Ollama:    ollama/llama3.1 (set LLM_BASE_URL unless Ollama runs on localhost:11434)
# LLM_MODEL=openai/gpt-4o

# Provider endpoint, when not the provider's default
# LLM_BASE_URL=http://localhost:11434

# Temperature answers are generated at (/query and chat)
# LLM_TEMPERATURE=0.1

# =============================================================================
# RAG pipeline (defaults; most can also be changed at runtime in the admin UI)
# =============================================================================

# Chunking strategy: simple, sentence, markdown, semantic
# RAG_CHUNKING_STRATEGY=sentence
# Target chunk size and overlap, in characters
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150

# Context chunks retrieved per query
# RAG_TOP_K=5
# Hybrid search fusion: rrf, weighted, vector_only, keyword_only
# RAG_FUSION_STRATEGY=rrf
# RRF k parameter (rrf only)
# RAG_RRF_K=60

# Reranking of hybrid-search candidates: none, cohere (needs COHERE_API_KEY) or llm.
# Not applied in permission mode.
# RAG_RERANKING_STRATEGY=none
# RAG_RERANKING_MODEL=rerank-english-v3.0
# RAG_RERANKING_CANDIDATES=30

# Query transformation before retrieval: none or llm-rewrite. Not applied in permission mode.
# RAG_QUERY_TRANSFORM=none

# Earlier chat messages sent to the LLM with each question (0 = none)
# RAG_CHAT_HISTORY_MESSAGES=10

# System prompt for answer generation (the default asks for concise answers from the context only)
# RAG_SYSTEM_PROMPT="You are a helpful assistant ..."

# =============================================================================
# Ingestion
# =============================================================================

# Directory source from the environment (added to any sources in application.conf).
# Path as seen by the server process.
# INGEST_DIR=/data/docs
#
# With docker compose, INGEST_DIR is fixed to /data inside the container; set the host
# directory to mount there instead:
# INGEST_HOST_DIR=./data

# File patterns (comma-separated) and recursion
# INGEST_PATTERNS=*.md,*.txt,*.pdf
# INGEST_RECURSIVE=true

# Ingest every configured source once at startup (with or without INGEST_DIR)
# INGEST_ON_STARTUP=false

# Re-ingestion schedule for every configured source: a five-field cron expression in
# INGEST_SCHEDULE_TZ ("0 2 * * *" = 02:00 daily; Sunday = 0), "hourly" / "daily" / "weekly",
# or an interval from startup ("30m", "6h", "1d"). An invalid value fails startup. Unset: no schedule.
# INGEST_SCHEDULE="0 2 * * *"

# Time zone cron schedules are evaluated in: an IANA name ("Europe/London", "UTC") or an
# offset ("+02:00"). Unset: the server's time zone. An invalid value fails startup.
# INGEST_SCHEDULE_TZ=UTC

# Directories POST /api/v1/ingest/directory (and directory sources) may read under,
# comma-separated, compared after resolving symlinks. Defaults to the configured directory
# sources (e.g. INGEST_DIR); with none, API directory ingestion is disabled.
# INGEST_ALLOWED_ROOTS=/data/docs,/data/kb

# URL / web-crawler ingestion only fetches public http(s) addresses. Optionally restrict it
# further to these hosts (comma-separated; "*.example.com" matches subdomains):
# INGEST_URL_ALLOWED_HOSTS=docs.example.com,*.example.org
# Allow hosts on loopback, private and other non-public addresses, to ingest from
# an intranet. Cloud metadata addresses stay refused.
# INGEST_URL_ALLOW_PRIVATE_NETWORKS=false

# =============================================================================
# Authentication
# =============================================================================

# Mode: open (default; development only), basic (username/password + JWT) or oauth (OIDC SSO)
# AUTH_MODE=open

# Static API key (any mode); its holder is an administrator. In open mode, setting it makes
# every request authenticate. Sent as `X-API-Key: <key>` or `Authorization: Bearer <key>`.
# Generate with: openssl rand -hex 32
# API_KEY=

# --- basic mode ---
# REQUIRED in basic mode. JWT signing secret, 32+ characters. Generate with: openssl rand -hex 32
# JWT_SECRET=
# JWT lifetime in seconds, and the iss / aud claims written into and required of every JWT
# JWT_EXPIRATION=86400
# JWT_ISSUER=rag-in-a-box
# JWT_AUDIENCE=rag-in-a-box

# Bootstrap administrator. ADMIN_PASSWORD is REQUIRED in basic mode: it creates the admin
# account when there are no users yet (PASSWORD_MIN_LENGTH+ characters, not "admin").
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Password policy and hashing (PBKDF2-HMAC-SHA256 iterations for new hashes)
# PASSWORD_MIN_LENGTH=12
# PASSWORD_HASH_ITERATIONS=600000

# --- oauth mode (see docs/oauth-configuration.md) ---
# Provider preset: google, azure, okta, keycloak, custom
# OAUTH_PROVIDER=google
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/oauth/callback
# Provider-specific
# OAUTH_AZURE_TENANT_ID=
# OAUTH_OKTA_DOMAIN=
# OAUTH_OKTA_AUTH_SERVER_ID=default
# OAUTH_KEYCLOAK_BASE_URL=
# OAUTH_KEYCLOAK_REALM=
# Custom provider endpoints
# OAUTH_AUTHORIZATION_ENDPOINT=
# OAUTH_TOKEN_ENDPOINT=
# OAUTH_USERINFO_ENDPOINT=
# OAUTH_JWKS_URI=
# OAUTH_ISSUER=
# Scopes to request, space- or comma-separated (must include openid); default: the preset's
# OAUTH_SCOPES=openid profile email
# Claim mapping
# OAUTH_CLAIM_USER_ID=sub
# OAUTH_CLAIM_EMAIL=email
# OAUTH_CLAIM_GROUPS=groups
# OAUTH_CLAIM_NAME=name
# Comma-separated groups whose members are administrators (default: none)
# OAUTH_ADMIN_GROUPS=
# Session cookie (set OAUTH_SESSION_COOKIE_SECURE=false only for plain-http local testing)
# OAUTH_SESSION_COOKIE_NAME=ragbox_session
# OAUTH_SESSION_COOKIE_SECURE=true
# OAUTH_SESSION_MAX_AGE=86400
# Login-state lifetime in seconds (PKCE is always used)
# OAUTH_STATE_TTL=300
# Where sessions live: memory (single instance) or postgres (shared by replicas)
# OAUTH_SESSION_STORAGE=memory

# --- trusted proxy (all modes) ---
# Let an administrator credential (e.g. a gateway holding API_KEY) act for an end user with
# X-User-Id / X-Group-Ids. Only enable behind a proxy that sets these headers itself.
# AUTH_TRUSTED_PROXY_HEADERS=false
# With trusted proxy headers, also honour X-Admin: true
# ALLOW_ADMIN_HEADER=false

# =============================================================================
# Hardening
# =============================================================================

# CORS: by default only the server's own origin (the admin UI at /admin) may call the API
# from a browser. List other origins (comma-separated), or "*" for any.
# ALLOWED_ORIGINS=https://app.example.com
# Allow every origin when ALLOWED_ORIGINS is unset (not recommended)
# CORS_ALLOW_ALL_ORIGINS=false

# Per-client rate limit (failed authentication counts too)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies whose X-Forwarded-For / X-Real-IP identify the client (IPs / CIDRs, comma-separated)
# RATE_LIMIT_TRUSTED_PROXIES=10.0.0.0/8
# Most clients tracked at once
# RATE_LIMIT_MAX_CLIENTS=10000
# Login throttling (on even when rate limiting is off): failed logins allowed per IP and per
# username per window (0 disables)
# RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Request body size limit
# REQUEST_SIZE_ENABLED=true
# MAX_BODY_SIZE_MB=10

# Graceful shutdown
# SHUTDOWN_TIMEOUT_SECONDS=30
# SHUTDOWN_DRAIN_SECONDS=5

# =============================================================================
# Observability
# =============================================================================

# Log level: DEBUG, INFO, WARN, ERROR
# LOG_LEVEL=INFO
# Log format: json for structured logs (production); anything else is human-readable console output
# LOG_FORMAT=console

# Prometheus metrics at /metrics (administrators only unless METRICS_REQUIRE_AUTH=false)
# METRICS_ENABLED=false
# METRICS_REQUIRE_AUTH=true
