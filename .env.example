# RAG in a Box - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys (at least one LLM provider required)
# =============================================================================

# OpenAI API key (required for OpenAI embeddings and LLM)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API key (optional, for Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# VoyageAI API key (optional, for Voyage embeddings)
# VOYAGE_API_KEY=pa-your-voyage-key-here

# =============================================================================
# Server Settings
# =============================================================================

# Server bind address and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# =============================================================================
# Database Settings
# =============================================================================

# PostgreSQL connection (individual settings)
PG_HOST=localhost
PG_PORT=15432
PG_DATABASE=ragdb
PG_USER=rag
PG_PASSWORD=rag

# Alternative: Full connection URL (overrides individual settings)
# Format: postgresql://[user[:password]@]host[:port][/database][?params]
# postgres:// and jdbc:postgresql:// are also accepted. Percent-encode special
# characters in the password (e.g. @ -> %40). Port defaults to 5432; a missing
# user/password/database falls back to PG_USER/PG_PASSWORD/PG_DATABASE.
# DATABASE_URL=postgresql://rag:rag@localhost:15432/ragdb

# Fail startup if permission-based RAG cannot be initialized, instead of
# falling back to legacy mode where queries ignore document permissions.
# PERMISSIONS_REQUIRED=false

# =============================================================================
# Embedding Settings
# =============================================================================

# Embedding provider: openai, voyage, ollama
EMBEDDING_PROVIDER=openai

# Embedding model (provider-specific)
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Voyage: voyage-3, voyage-3-lite, voyage-code-3
# Ollama: nomic-embed-text, mxbai-embed-large
EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# LLM Settings
# =============================================================================

# LLM model for answer generation (format: provider/model)
# OpenAI: openai/gpt-4o, openai/gpt-4o-mini, openai/gpt-4-turbo
# Anthropic: anthropic/claude-3-opus, anthropic/claude-3-sonnet, anthropic/claude-3-haiku
LLM_MODEL=openai/gpt-4o

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.1

# =============================================================================
# RAG Settings
# =============================================================================

# Chunking strategy: simple, sentence, markdown, semantic
RAG_CHUNKING_STRATEGY=sentence

# Target chunk size in characters
RAG_CHUNK_SIZE=800

# Overlap between chunks in characters
RAG_CHUNK_OVERLAP=150

# Number of context chunks to retrieve
RAG_TOP_K=5

# Search fusion strategy: rrf, weighted, vector_only, keyword_only
RAG_FUSION_STRATEGY=rrf

# =============================================================================
# Ingestion Settings (Built-in Connectors)
# =============================================================================

# Directory to ingest (path as seen by the application process)
# INGEST_DIR=/data/docs
#
# With docker compose, INGEST_DIR is fixed to /data inside the container;
# set the host directory to mount there instead:
# INGEST_HOST_DIR=/path/to/your/docs

# File patterns to include (comma-separated)
# INGEST_PATTERNS=*.md,*.txt,*.pdf

# Recursive directory scanning
# INGEST_RECURSIVE=true

# Run ingestion on startup
# INGEST_ON_STARTUP=true

# Ingestion schedule (e.g., "6h", "daily", "0 */6 * * *")
# INGEST_SCHEDULE=6h

# Directories POST /api/v1/ingest/directory (and directory sources) may read under,
# comma-separated, compared after resolving symlinks. Defaults to INGEST_DIR; when neither
# is set, API directory ingestion is disabled.
# INGEST_ALLOWED_ROOTS=/data/docs,/data/kb

# URL / web-crawler ingestion only fetches public http(s) addresses. Optionally restrict it
# further to these hosts (comma-separated; "*.example.com" matches subdomains):
# INGEST_URL_ALLOWED_HOSTS=docs.example.com,*.example.org
# Skip ragbox's private-address check (default false). llm4s 0.6.0 still refuses
# private addresses itself, so this does not yet enable intranet crawling.
# INGEST_URL_ALLOW_PRIVATE_NETWORKS=false

# =============================================================================
# API Authentication (Optional)
# =============================================================================

# API key for authenticating requests (leave empty to disable). Sent as X-API-Key or
# Authorization: Bearer; ?api_key= is not accepted. Generate with: openssl rand -base64 32
# API_KEY=

# Auth mode: open (default, development only), basic (username/password) or oauth
# AUTH_MODE=basic
# Basic mode: both required. ADMIN_PASSWORD needs 12+ characters (PASSWORD_MIN_LENGTH) and
# must not be "admin"; JWT_SECRET needs 32+ characters. Placeholders such as CHANGE_ME or
# REPLACE-ME are rejected at startup.
# ADMIN_PASSWORD=
# JWT_SECRET=

# =============================================================================
# Hardening (Optional)
# =============================================================================

# CORS: by default only the server's own origin (the admin UI at /admin) may call the API from
# a browser. List other origins here (comma-separated), or "*" for any.
# ALLOWED_ORIGINS=https://app.example.com

# Per-client rate limit; failed authentication counts too
# RATE_LIMIT_ENABLED=true
# Reverse proxies whose X-Forwarded-For identifies the client (IPs / CIDRs, comma-separated)
# RATE_LIMIT_TRUSTED_PROXIES=10.0.0.0/8
# Failed logins allowed per IP and per username per 300s window (0 disables)
# RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10

# =============================================================================
# Observability (Optional)
# =============================================================================

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Enable Prometheus metrics endpoint at /metrics (administrators only unless
# METRICS_REQUIRE_AUTH=false)
# METRICS_ENABLED=true
# METRICS_REQUIRE_AUTH=true
