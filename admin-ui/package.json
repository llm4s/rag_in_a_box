{
  "name": "ragbox-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build",
    "test:e2e:db": "docker run --rm -d --name ragbox-e2e-pg -e POSTGRES_USER=rag -e POSTGRES_PASSWORD=rag -e POSTGRES_DB=ragdb -p 15433:5432 pgvector/pgvector:pg16"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.21.1",
    "chart.js": "^4.5.1",
    "pinia": "^2.1.7",
    "swagger-ui-dist": "^5.35.1",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.2.5",
    "vuetify": "^3.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.4",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-onboarding": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/vue3-vite": "^10.6.8",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.2",
    "eslint-plugin-storybook": "^10.6.8",
    "eslint-plugin-vue": "^10.6.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.65.1",
    "sass": "^1.69.0",
    "storybook": "^10.6.8",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.51.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
